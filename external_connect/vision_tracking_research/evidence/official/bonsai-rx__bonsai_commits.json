[{"sha":"ba3abbcb07d7f64aff63aca613587a71858bd806","node_id":"C_kwDODucDptoAKGJhM2FiYmNiMDdkN2Y2NGFmZjYzYWNhNjEzNTg3YTcxODU4YmQ4MDY","commit":{"author":{"name":"glopesdev","email":"g.lopes@neurogears.org","date":"2026-08-03T22:15:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-03T22:15:37Z"},"message":"Avoid caching serializer types on failure (#2656)\n\nThe workflow serializer type set and generic type map are now\nassigned only after the serializer is successfully created. A\nworkflow that cannot be serialized would otherwise leave the new\ntypes recorded against the previously cached serializer, so every\nlater attempt in the same session would either reuse a serializer\nthat knows nothing about them, or fail again while reporting types\nabsent from the workflow being serialized.\n\nCloses #2655","tree":{"sha":"6e07969f543e9b7104113997a178cc936c69f133","url":"https://api.github.com/repos/bonsai-rx/bonsai/git/trees/6e07969f543e9b7104113997a178cc936c69f133"},"url":"https://api.github.com/repos/bonsai-rx/bonsai/git/commits/ba3abbcb07d7f64aff63aca613587a71858bd806","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqcRMJCRC1aQ7uu5UhlAAAgu8QADEPi3qhW5u3g3mvBz5E8zi/\nD364ZPVbx07WG+hMrSLBJRRYzUc7scS71YU2pUeeCfaTumoAR9WUsseKekCH2bdi\ncxGShgqrwpBk3PQ7axsicc2hgI/Khvzm9Vf7sEtIPTd/ex3aucyLY5s1blj27wCa\nF7YIzmgpOcnUrcUCtyTAoiOyP2sEDIbyUxFPF72Vhosi0lNI/4eXNjtehZYz8tr9\niS4Kcks0KUmFOpn/T2yEnbo6yNQCE2fIaDYlwMZHMpR+ZO4074Y0pUUjFLqeygpk\nMy6+RgQAvf8c7Zf1whGwAJsjjbAM2jNwAyu8tdC9aVy1Q0OpLcXyJHYdPyor6Q3J\nhPqmH95oF3oHwbK/Nv05wAV4p66gerqvqgEcO6+KFTjPi/1fYA7J84kpLNiyNA4n\nSVm4sG9tL/PZEx3WJrLcz5UXGS6WqqSJoQHo2XiLtF0JIQy2SSsIbNiRi841mEr9\nzyoWzCJnTDNmR/nzze0YKt5Du1gqdnq7L1f4Ro23jMdKMB9aqn0vr2F8N16QaXXZ\ncUNNmwTUwlJeCMJZP1g9I/EL/cf/Ctkjic9uAfnHUo29+KAUGpu1tvsh+we/OQNw\nCK1OP1vmIjEUg9j0oDAAO2H8OR7XDzx1ImYvDa3fOnWXAL7Igs9KI3BImAZ1HykX\nGcS5482KRzPmunZuDMj9\n=GWVn\n-----END PGP SIGNATURE-----\n","payload":"tree 6e07969f543e9b7104113997a178cc936c69f133\nparent 55df51f5b673950e9169d92d83ff28512c60a834\nauthor glopesdev <g.lopes@neurogears.org> 1785795337 +0100\ncommitter GitHub <noreply@github.com> 1785795337 +0100\n\nAvoid caching serializer types on failure (#2656)\n\nThe workflow serializer type set and generic type map are now\nassigned only after the serializer is successfully created. A\nworkflow that cannot be serialized would otherwise leave the new\ntypes recorded against the previously cached serializer, so every\nlater attempt in the same session would either reuse a serializer\nthat knows nothing about them, or fail again while reporting types\nabsent from the workflow being serialized.\n\nCloses #2655","verified_at":"2026-08-03T22:39:46Z"}},"url":"https://api.github.com/repos/bonsai-rx/bonsai/commits/ba3abbcb07d7f64aff63aca613587a71858bd806","html_url":"https://github.com/bonsai-rx/bonsai/commit/ba3abbcb07d7f64aff63aca613587a71858bd806","comments_url":"https://api.github.com/repos/bonsai-rx/bonsai/commits/ba3abbcb07d7f64aff63aca613587a71858bd806/comments","author":{"login":"glopesdev","id":5315880,"node_id":"MDQ6VXNlcjUzMTU4ODA=","avatar_url":"https://avatars.githubusercontent.com/u/5315880?v=4","gravatar_id":"","url":"https://api.github.com/users/glopesdev","html_url":"https://github.com/glopesdev","followers_url":"https://api.github.com/users/glopesdev/followers","following_url":"https://api.github.com/users/glopesdev/following{/other_user}","gists_url":"https://api.github.com/users/glopesdev/gists{/gist_id}","starred_url":"https://api.github.com/users/glopesdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/glopesdev/subscriptions","organizations_url":"https://api.github.com/users/glopesdev/orgs","repos_url":"https://api.github.com/users/glopesdev/repos","events_url":"https://api.github.com/users/glopesdev/events{/privacy}","received_events_url":"https://api.github.com/users/glopesdev/received_events","ty