+                    prefix+'VOLTage:LEVel:IMMediate:AMPLitude?', prefix+'PHASe:ADJust?',
+                    prefix+'FUNCtion:SHAPe?', prefix+'FREQuency:MODE?', prefix+'BURSt:STATe?']
+        values = [rig._query(session, command) for command in commands]
+        frequency, amplitude, phase_rad = map(float, values[1:4])
+        if not all(math.isfinite(v) for v in (frequency, amplitude, phase_rad)) or frequency <= 0 or amplitude < 0:
+            raise ValueError('Invalid monitor parameter response')
+        if not values[4] or not values[5]:
+            raise ValueError('Empty waveform or mode response')
+        return dict(output=rig._state(values[0]), frequency_hz=frequency, amplitude_vpp=amplitude,
+                    phase_deg=math.degrees(phase_rad) % 360, waveform=values[4],
+                    frequency_mode=values[5], burst_enabled=rig._state(values[6]))
 
 
