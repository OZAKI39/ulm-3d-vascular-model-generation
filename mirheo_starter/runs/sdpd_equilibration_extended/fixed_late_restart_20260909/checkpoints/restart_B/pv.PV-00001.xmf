<?xml version="1.0"?>
<Xdmf Version="3.0">
	<Domain>
		<Grid Name="mesh" GridType="Uniform">
			<Topology TopologyType="Polyvertex" NumberOfElements="4096" />
			<Geometry GeometryType="XYZ">
				<DataItem Dimensions="4096 3" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/position</DataItem>
			</Geometry>
			<Attribute Name="saved_stresses" AttributeType="Tensor6" Center="Node">
				<Information Name="Typeinfo" Value="Tensor6" Datatype="Stress" RequireShift="False" />
				<DataItem Dimensions="4096 6" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/saved_stresses</DataItem>
			</Attribute>
			<Attribute Name="saved_forces" AttributeType="Scalar" Center="Node">
				<Information Name="Typeinfo" Value="Other" Datatype="Force" RequireShift="False" />
				<DataItem Dimensions="4096 1" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/saved_forces</DataItem>
			</Attribute>
			<Attribute Name="saved_positions" AttributeType="Matrix" Center="Node">
				<Information Name="Typeinfo" Value="Vector4" Datatype="float4" RequireShift="False" />
				<DataItem Dimensions="4096 4" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/saved_positions</DataItem>
			</Attribute>
			<Attribute Name="saved_velocities" AttributeType="Matrix" Center="Node">
				<Information Name="Typeinfo" Value="Vector4" Datatype="float4" RequireShift="False" />
				<DataItem Dimensions="4096 4" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/saved_velocities</DataItem>
			</Attribute>
			<Attribute Name="saved_density" AttributeType="Scalar" Center="Node">
				<Information Name="Typeinfo" Value="Scalar" Datatype="float" RequireShift="False" />
				<DataItem Dimensions="4096 1" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/saved_density</DataItem>
			</Attribute>
			<Attribute Name="velocities" AttributeType="Vector" Center="Node">
				<Information Name="Typeinfo" Value="Vector" Datatype="float" RequireShift="False" />
				<DataItem Dimensions="4096 3" NumberType="Float" Precision="4" Format="HDF">pv.PV-00001.h5:/velocities</DataItem>
			</Attribute>
			<Attribute Name="ids" AttributeType="Scalar" Center="Node">
				<Information Name="Typeinfo" Value="Scalar" Datatype="int64_t" RequireShift="False" />
				<DataItem Dimensions="4096 1" NumberType="Int" Precision="8" Format="HDF">pv.PV-00001.h5:/ids</DataItem>
			</Attribute>
		</Grid>
	</Domain>
</Xdmf>
