# Local environments, third-party checkouts and build products.
/.venv/
/venv/
/vendor/
/downloads/
/build/
/dist/
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.env
.env.*

# This branch also archives real data, complete run evidence and offline reports.
# Override the repository-wide generated-output and geometry exclusions here.
!/data/
!/data/**
!/runs/
!/runs/**
!/logs/
!/logs/**
!/test_code/outputs/
!/test_code/outputs/**

# Transient state is not part of a scientific snapshot.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/temporary_browser_profile/
**/node_modules/
*.lock
**/.env
**/.env.*

# metadata/ contains the original text-only environment and patch records.
