+    ! Express both ray and triangle in link-local, dimensionless coordinates.
+    ! The ray parameter therefore remains the fraction along the lattice link.
+    local_scale = maxval(abs(line%vec))
+    if (local_scale <= 0._rk) return
+
+    vertex0 = (triangle%nodes(:,1) - line%origin) / local_scale
+    edge1 = (triangle%nodes(:,2) - triangle%nodes(:,1)) / local_scale
+    edge2 = (triangle%nodes(:,3) - triangle%nodes(:,1)) / local_scale
+    direction = line%vec / local_scale
