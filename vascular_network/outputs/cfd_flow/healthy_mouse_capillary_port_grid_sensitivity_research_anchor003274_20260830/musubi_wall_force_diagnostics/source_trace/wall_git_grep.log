source/bc/mus_bndForce_module.fpp:360:          cNgh = me%bouzidi(iLevel)%cNgh( iLink )
source/bc/mus_bndForce_module.fpp:363:          fIn = currState(                                           &
source/bc/mus_bndForce_module.fpp:366:          fOut = currState(                                          &
source/bc/mus_bndForce_module.fpp:367:            & ?SAVE?(invDir, 1, elemPos, QQ, nScalars, nSize, neigh) )
source/bc/mus_bndForce_module.fpp:370:          ! using FETCH in invDir
source/bc/mus_bndForce_module.fpp:371:          fOutNeigh = currState(                                          &
source/bc/mus_bndForce_module.fpp:372:            & ?FETCH?(invDir, 1, elemPos, QQ, nScalars, nSize, neigh) )
source/bc/mus_bndForce_module.fpp:374:          ! Incoming interpolated state according to bouzidi rule
source/bc/mus_bndForce_module.fpp:375:          fIntp = cIn*fIn + cOut*fOut + cNgh*fOutNeigh
source/bc/mus_bndForce_module.fpp:378:!          ! currState using SAVE macro in invDir since this value is
source/bc/mus_bndForce_module.fpp:380:!          fOut = currState(                                          &
source/bc/mus_bndForce_module.fpp:381:!            & ?SAVE?(invDir, 1, elemPos, QQ, nScalars, nSize, neigh) )
source/bc/mus_bndForce_module.fpp:383:          force = force + layout%fStencil%cxDirRK(:, invDir) * (fOut + fIntp)
