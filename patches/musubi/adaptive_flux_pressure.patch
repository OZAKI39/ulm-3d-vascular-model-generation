+! ****************************************************************************** !
+  !> Enforce one global volumetric flux by solving a uniform pressure density
+  !! and then using the native pressure_eq equilibrium replacement.
+  subroutine adaptive_flux_pressure( me, state, bcBuffer, globBC, levelDesc, &
+    &                                tree, nSize, iLevel, sim_time, neigh,    &
+    &                                layout, fieldProp, varPos, nScalars,    &
+    &                                varSys, derVarPos, physics, iField,     &
+    &                                mixture )
+    class(boundary_type) :: me
+    real(kind=rk), intent(inout) :: state(:)
+    real(kind=rk), intent(in) :: bcBuffer(:)
+    type(glob_boundary_type), intent(in) :: globBC
+    type(tem_levelDesc_type), intent(in) :: levelDesc
+    type(treelmesh_type), intent(in) :: tree
+    integer, intent(in) :: nSize, iLevel, nScalars, iField
+    type(tem_time_type), intent(in) :: sim_time
+    integer, intent(in) :: neigh(:), varPos(:)
+    type(mus_scheme_layout_type), intent(in) :: layout
+    type(mus_field_prop_type), intent(in) :: fieldProp
+    type(tem_varSys_type), intent(in) :: varSys
+    type(mus_derVarPos_type), intent(in) :: derVarPos
+    type(mus_physics_type), intent(in) :: physics
+    type(mus_mixture_type), intent(in) :: mixture
+    real(kind=rk) :: massFlowRate(globBC%nElems(iLevel))
+    real(kind=rk) :: velocity(3,globBC%nElems(iLevel))
+    real(kind=rk) :: rho(globBC%nElems(iLevel))
+    real(kind=rk) :: rhoUnit(globBC%nElems(iLevel))
+    real(kind=rk) :: fEqUnit(layout%fStencil%QQ*globBC%nElems(iLevel))
+    real(kind=rk) :: alphaLocal, betaLocal, alpha, beta
+    real(kind=rk) :: massLocal, massGlobal, targetMassFlow, targetFlux
+    real(kind=rk) :: controlledFlux, relativeError, pressure, rhoBoundary
+    real(kind=rk) :: minPdfLocal, minPdf, maxSpeedLocal, maxSpeed
+    real(kind=rk) :: fVal, rhoElem, momentum(3), speed
+    integer :: bcMfr_pos, iElem, iDir, elemPos, QQ, iErr
+
+    if (layout%fStencil%QQ /= 19 .or. layout%fStencil%QQN /= 18) then
+      call tem_abort('adaptive_flux_pressure supports only D3Q19')
+    end if
+    if (tree%global%minLevel /= tree%global%maxLevel) then
+      call tem_abort('adaptive_flux_pressure supports one uniform level')
+    end if
+    QQ = layout%fStencil%QQ
+
+    bcMfr_pos = me%bc_states%massFlowRate%varPos
+    call varSys%method%val(bcMfr_pos)%get_valOfIndex( &
+      & varSys  = varSys,                             &
+      & time    = sim_time,                           &
+      & iLevel  = iLevel,                             &
+      & idx     = me%bc_states%massFlowRate           &
+      &           %pntIndex%indexLvl(iLevel)          &
+      &           %val(1:globBC%nElems(iLevel)),      &
+      & nVals   = globBC%nElems(iLevel),              &
+      & res     = massFlowRate                        )
+    massLocal = sum(massFlowRate)
+    call mpi_allreduce(massLocal, massGlobal, 1, rk_mpi, mpi_sum, &
+      &                tree%global%comm, iErr)
+    if (globBC%nElems_total <= 0) then
+      call tem_abort('adaptive_flux_pressure has no boundary elements')
+    end if
+    targetMassFlow = massGlobal / real(globBC%nElems_total, kind=rk)
+    targetFlux = targetMassFlow / physics%rho0 * physics%dtLvl(iLevel) &
+      &          / physics%dxLvl(iLevel)**3
+
+    call pressure_eq_velocity( me        = me,        &
+      &                        globBC    = globBC,    &
+      &                        iLevel    = iLevel,    &
+      &                        derVarPos = derVarPos, &
+      &                        iField    = iField,    &
+      &                        varSys    = varSys,    &
+      &                        layout    = layout,    &
+      &                        velocity  = velocity   )
+    rhoUnit = 1.0_rk
+    call derVarPos%equilFromMacro( density  = rhoUnit,              &
+      &                            velocity = velocity,             &
+      &                            iField   = iField,               &
+      &                            nElems   = globBC%nElems(iLevel),&
+      &                            varSys   = varSys,               &
+      &                            layout   = layout,               &
+      &                            res      = fEqUnit                )
+
+    alphaLocal = 0.0_rk
+    betaLocal = 0.0_rk
+    do iElem = 1, globBC%nElems(iLevel)
+      elemPos = globBC%elemLvl(iLevel)%elem%val(iElem)
+      do iDir = 1, layout%fStencil%QQN
+        if (globBC%elemLvl(iLevel)%bitmask%val(iDir, iElem)) then
+          alphaLocal = alphaLocal + fEqUnit((iElem-1)*QQ+iDir)
+          betaLocal = betaLocal - state( &
+            & ?FETCH?(iDir, iField, elemPos, QQ, nScalars, nSize, neigh) )
+        end if
+      end do
+    end do
+    call mpi_allreduce(alphaLocal, alpha, 1, rk_mpi, mpi_sum, &
+      &                tree%global%comm, iErr)
+    call mpi_allreduce(betaLocal, beta, 1, rk_mpi, mpi_sum, &
+      &                tree%global%comm, iErr)
+    if (abs(alpha) <= tiny(alpha)) then
+      call tem_abort('adaptive_flux_pressure alpha is zero')
+    end if
+    rhoBoundary = (targetFlux-beta) / alpha
+    rho = rhoBoundary
+    controlledFlux = alpha*rhoBoundary + beta
+    relativeError = abs(controlledFlux-targetFlux) / max(abs(targetFlux), &
+      &                                                   tiny(targetFlux))
+    pressure = rhoBoundary * physics%fac(iLevel)%press * cs2
+
+    call pressure_eq_reconstruct( state      = state,      &
+      &                           rho        = rho,        &
+      &                           velocity   = velocity,   &
+      &                           globBC     = globBC,     &
+      &                           iLevel     = iLevel,     &
+      &                           nSize      = nSize,      &
+      &                           neigh      = neigh,      &
+      &                           layout     = layout,     &
+      &                           nScalars   = nScalars,   &
+      &                           varSys     = varSys,     &
+      &                           derVarPos  = derVarPos,  &
+      &                           iField     = iField      )
+
+    minPdfLocal = huge(minPdfLocal)
+    maxSpeedLocal = 0.0_rk
+    do iElem = 1, globBC%nElems(iLevel)
+      elemPos = globBC%elemLvl(iLevel)%elem%val(iElem)
+      rhoElem = 0.0_rk
+      momentum = 0.0_rk
+      do iDir = 1, QQ
+        fVal = state( &
+          & ?FETCH?(iDir, iField, elemPos, QQ, nScalars, nSize, neigh) )
+        minPdfLocal = min(minPdfLocal, fVal)
+        rhoElem = rhoElem + fVal
+        momentum = momentum + fVal*layout%fStencil%cxDirRK(:,iDir)
+      end do
+      if (rhoElem <= 0.0_rk) then
+        call tem_abort('adaptive_flux_pressure non-positive boundary density')
+      end if
+      speed = sqrt(sum((momentum/rhoElem)**2))
+      maxSpeedLocal = max(maxSpeedLocal, speed)
+    end do
+    call mpi_allreduce(minPdfLocal, minPdf, 1, rk_mpi, mpi_min, &
+      &                tree%global%comm, iErr)
+    call mpi_allreduce(maxSpeedLocal, maxSpeed, 1, rk_mpi, mpi_max, &
+      &                tree%global%comm, iErr)
+    if (tree%global%myPart == 0) then
+      write(logUnit(1),'(A,I0,7(A,ES24.16E3),A,I0)') &
+        & 'ADAPTIVE_FLUX_PRESSURE iter=', sim_time%iter, &
+        & ' target_lattice=', targetFlux,                &
+        & ' controlled_lattice=', controlledFlux,        &
+        & ' relative_error=', relativeError,             &
+        & ' rho_boundary=', rhoBoundary,                 &
+        & ' pressure_pa=', pressure,                     &
+        & ' max_lattice_velocity=', maxSpeed,            &
+        & ' minimum_pdf=', minPdf,                       &
+        & ' globBC_count=', globBC%nElems_total
+      flush(logUnit(1))
+    end if
+  end subroutine adaptive_flux_pressure
 ! ****************************************************************************** !
 
 
