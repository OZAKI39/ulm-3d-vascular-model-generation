+! ****************************************************************************** !
+  !> Native pressure_eq velocity extrapolation shared by fixed and adaptive
+  !! pressure boundary conditions.
+  subroutine pressure_eq_velocity( me, globBC, iLevel, derVarPos, iField, &
+    &                              varSys, layout, velocity )
+    class(boundary_type), intent(in) :: me
+    type(glob_boundary_type), intent(in) :: globBC
+    integer, intent(in) :: iLevel, iField
+    type(mus_derVarPos_type), intent(in) :: derVarPos
