b0d2fd153bbc12b98a2f7ca4d6d8e2d442ce","url":"https://api.github.com/repos/lammps/lammps/commits/5477b0d2fd153bbc12b98a2f7ca4d6d8e2d442ce","html_url":"https://github.com/lammps/lammps/commit/5477b0d2fd153bbc12b98a2f7ca4d6d8e2d442ce"}]},{"sha":"42a13baa111382d014cb2b5d4f1a5d31f88cb704","node_id":"C_kwDOALc2dtoAKDQyYTEzYmFhMTExMzgyZDAxNGNiMmI1ZDRmMWE1ZDMxZjg4Y2I3MDQ","commit":{"author":{"name":"Axel Kohlmeyer","email":"akohlmey@gmail.com","date":"2026-06-25T13:51:35Z"},"committer":{"name":"Axel Kohlmeyer","email":"akohlmey@gmail.com","date":"2026-06-25T13:51:35Z"},"message":"Initialize COLLOID class-member pointers to nullptr in constructors\n\nCoverity \"Uninitialized pointer field\" defects in the COLLOID package (5 file(s)):\nthe constructor initializer lists now null every previously-uninitialized\nclass-member pointer, in declaration order (-Wreorder clean). This makes a\ndestructor that runs on a partially-constructed object (e.g. after an\nexception during setup, or a deleted-then-recreated style) free only nullptr\ninstead of an indeterminate address, per the LAMMPS coding standard.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01HrAVWctE6TRM5n875zpBnu","tree":{"sha":"471b1d38bfd027701c46f743c3711d024f843642","url":"https://api.github.com/repos/lammps/lammps/git/trees/471b1d38bfd027701c46f743c3711d024f843642"},"url":"https://api.github.com/repos/lammps/lammps/git/commits/42a13baa111382d014cb2b5d4f1a5d31f88cb704","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQJHBAABCgAxFiEE7qEDdkxsYz7cisQo2bROk78MN1oFAmo9MmcTHGFrb2hsbWV5\nQGdtYWlsLmNvbQAKCRDZtE6Tvww3Wrt/EACB5dqUYWfoJxO+wZ4iuZwhyKVznB7I\npPSL5+oNv9JwvdltSEfiBo6KbjZ+jzz1nhYFbexNyKFw+MoV8ceaDbT7cokOzSqh\nL/byTbHRA1VKzLIzQJppYwbFdX5pw2l8WYElL2Ngztl17ZfYwahMJyiq/iFq5Sga\nQRWIMmrlJbKem2oTv526qqBpdtcRHdo3TMen3EWaOIGKWOSVJdBvl+3GZsrx/RlH\naIOYMD+heacW4gbQMilXwM3+Ydi+qOf8BoVxdCawTvAG/AlcD9d6hTALe8ic5Vif\n0z3XYoFg11G8gP60kBM7vezw7zULiCrPl5eRIjAP0MTdDaYVf6LsZEKWLIcYY3Kn\nZFZpZjv1phnWImn6/Jp/d78+TS6/YQN7U9Lh/vdIgSpMPEDxKgy6XmvxTCJiIWoF\nBUjKKH0UXY4AEvnFnqnK18AuPR75NBnAjHR17RdeeoQqWsoyxAZ8RuwBn8lg8Xpz\nR4BGMF5H7EmnV5LSVECzIq0P5RBHgSeLYfHjOoOUSbSvUXSCHTL8xsqhtID09Ywn\nfowsWq4btVME+PDlQs8lhp6MYKtWrDY83GwvDxWw/nJpstTezoSFFikYnoY+IZ6H\n/YhlFlcUR6pfs9eP/hXZsgZEt9cIJyP7S3+DSIiP85HKghwkkaIFY5UyNXr3R/6E\n6kbYNMu+CWaXNQ==\n=RVSf\n-----END PGP SIGNATURE-----","payload":"tree 471b1d38bfd027701c46f743c3711d024f843642\nparent 0b966a5301554aa168666430e4be229b054f526a\nauthor Axel Kohlmeyer <akohlmey@gmail.com> 1782395495 -0400\ncommitter Axel Kohlmeyer <akohlmey@gmail.com> 1782395495 -0400\n\nInitialize COLLOID class-member pointers to nullptr in constructors\n\nCoverity \"Uninitialized pointer field\" defects in the COLLOID package (5 file(s)):\nthe constructor initializer lists now null every previously-uninitialized\nclass-member pointer, in declaration order (-Wreorder clean). This makes a\ndestructor that runs on a partially-constructed object (e.g. after an\nexception during setup, or a deleted-then-recreated style) free only nullptr\ninstead of an indeterminate address, per the LAMMPS coding standard.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01HrAVWctE6TRM5n875zpBnu\n","verified_at":"2026-06-25T23:11:58Z"}},"url":"https://api.github.com/repos/lammps/lammps/commits/42a13baa111382d014cb2b5d4f1a5d31f88cb704","html_url":"https://github.com/lammps/lammps/commit/42a13baa111382d014cb2b5d4f1a5d31f88cb704","comments_url":"https://api.github.com/repos/lammps/lammps/commits/42a13baa111382d014cb2b5d4f1a5d31f88cb704/comments","author":{"login":"akohlmey","id":289251,"node_id":"MDQ6VXNlcjI4OTI1MQ==","avatar_url":"https://avatars.githubusercontent.com/u/289251?v=4","gravatar_id":"","url":"https://api.github.com/users/akohlmey","html_url":"https://github.com/akohlmey","followers_url":"https://api.github.com/users/ako