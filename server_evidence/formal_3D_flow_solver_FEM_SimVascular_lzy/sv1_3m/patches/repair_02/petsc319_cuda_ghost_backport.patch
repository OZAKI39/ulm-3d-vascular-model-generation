+PetscErrorCode VecConvert_MPI_MPICUDA_inplace(Vec v)
+{
+  PetscDeviceContext dctx;
+  PetscFunctionBegin;
+  PetscCall(PetscDeviceContextGetCurrentContextAssertType_Internal(&dctx, PETSC_DEVICE_CUDA));
