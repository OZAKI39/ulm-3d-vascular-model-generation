 PetscLinearAlgebra::PetscImpl::PetscImpl()
 {
 }
 
+void PetscLinearAlgebra::PetscImpl::finalize()
+{
+  // main finalizes each equation before MPI_Finalize; PETSc is process-wide.
+  if (!pesc_initialized) {
+    return;
+  }
+  int mpi_initialized = 0, mpi_finalized = 0;
+  MPI_Initialized(&mpi_initialized);
+  MPI_Finalized(&mpi_finalized);
+  if (!mpi_initialized || mpi_finalized) {
+    throw std::runtime_error("PETSc cleanup requires active application-owned MPI");
+  }
+  PetscBool initialized = PETSC_FALSE, finalized = PETSC_FALSE;
+  PetscCallAbort(MPI_COMM_WORLD, PetscInitialized(&initialized));
+  PetscCallAbort(MPI_COMM_WORLD, PetscFinalized(&finalized));
+  if (!initialized || finalized) {
+    throw std::runtime_error("PETSc lifecycle changed outside its solver owner");
+  }
+  petsc_destroy_all(petsc_equations);
+  petsc_equations = 0;
+  pesc_initialized = false;
+}
