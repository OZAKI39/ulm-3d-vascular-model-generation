+        path = __import__("pathlib").Path(row["run"]) / "trajectories.h5"
+        digest = sha(path)
+        with h5py.File(path) as h:
+            n = len(h["time_s"])
+            # Unused internal indices selected by a fixed hash recipe. Earlier
