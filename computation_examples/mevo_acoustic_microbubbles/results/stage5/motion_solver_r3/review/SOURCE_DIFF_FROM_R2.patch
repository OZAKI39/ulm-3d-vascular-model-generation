+                    ae = self.backend.solve(y, r, force, flow, we)
+                    self.timings["assembly"] += perf_counter() - beg
+                    ce = c
+                    if self.wall_contact_mode == "endpoint":
+                        ce = endpoint_wall_constraints(
+                            fixed_c, x, y, r, w0, we, dt, ids, self.tolerance, ae.velocity
