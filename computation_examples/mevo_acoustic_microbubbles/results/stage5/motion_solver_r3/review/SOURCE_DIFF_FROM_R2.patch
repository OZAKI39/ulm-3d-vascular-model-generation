+            initial_dt_s=1e-8,
+            output_clock_s=1e-5,
+            nominal=dict(max_dt_s=5e-6, tolerance_factor=0.25, S0_cap_s=50e-9),
+            refined=dict(max_dt_s=2.5e-6, tolerance_factor=0.0625, S0_cap_s=25e-9),
+        ),
+        numerical=dict(
+            kkt=1e-9,
