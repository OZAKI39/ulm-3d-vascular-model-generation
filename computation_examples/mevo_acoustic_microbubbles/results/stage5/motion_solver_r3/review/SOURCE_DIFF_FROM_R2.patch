+        BASE / "final/HOLDOUT_R3_V1.json",
+        dict(status=status, rows=rows, protocol_sha256=sha(BASE / "final/VALIDATION_PROTOCOL_R3_V1.json")),
+    )
+    print(dict(status=status, count=len(rows)), flush=True)
+
+
+if __name__ == "__main__":
+    main()
