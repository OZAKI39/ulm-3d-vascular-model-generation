+    )
+    assert result.returncode == 0, "SOURCE_BOUND_TESTS_FAILED"
+    assert before == sources()
+    suites = ET.parse(junit).getroot()
+    summary = {
+        key: sum(int(s.get(key, 0)) for s in suites.iter("testsuite"))
+        for key in ["tests", "failures", "errors", "skipped"]
