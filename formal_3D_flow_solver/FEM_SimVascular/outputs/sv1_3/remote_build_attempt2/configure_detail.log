class valClass
{
public:
  int i;
  valClass() { i = 3; }
  valClass(int x) : i(x) { }
};

class MoveSemantics
{
  std::unique_ptr<valClass> _member;

public:
  MoveSemantics(int val = 4) : _member(new valClass(val)) { }
  MoveSemantics& operator=(MoveSemantics &&other) noexcept = default;
};

