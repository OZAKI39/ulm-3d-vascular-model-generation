w = v;                // same effect as the previous line
S2 foo;
foo.f(ivar);
if constexpr (std::is_arithmetic_v<int>) std::cout << "c++17" << std::endl;
typedef std::integral_constant<Shapes,Shapes::SQUARE> squareShape;
