+ a=(t>=HOLD)&(t<OFF);z=(t[a]-HOLD)/(OFF-HOLD);q[a]=.5*(1+np.cos(np.pi*z));dq[a]=-.5*np.pi/(OFF-HOLD)*np.sin(np.pi*z)
+ return q,dq
+
+def bubble_model_input_gate(inputs):
