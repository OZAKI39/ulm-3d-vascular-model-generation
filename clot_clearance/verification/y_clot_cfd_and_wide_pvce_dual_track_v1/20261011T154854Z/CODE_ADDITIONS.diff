+    stop = None
+
+    def observe(done=False):
+        nonlocal stop
+        for path in sorted(result_dir.glob("result_*.vtu"),key=lambda p:int(p.stem.rsplit("_",1)[1])):
+            step = int(path.stem.rsplit("_",1)[1])
