+  extension=np.linalg.norm(delta_y(x,self.b),axis=1)-self.r;extension[abs(extension)<2.2204e-16]=0;return 3*self.V/self.m*np.bincount(self.b.ravel(),weights=np.repeat(self.h*extension*alive,2),minlength=len(x))
