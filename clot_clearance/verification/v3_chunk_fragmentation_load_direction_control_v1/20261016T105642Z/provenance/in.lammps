variable env0 atom exp(-((x-(-0.0061489101499319077))^2+(y-(1.9718387291674855e-05))^2+(z-(0.0007817580071923136))^2)/1.5679999999999997e-07)
variable spatial atom v_env0
variable amp equal ternary(time<0.00029012500000000002,0.5*(1-cos(4*PI*time/0.0011605000000000001)),ternary(time<0.00087037500000000005,1.0,ternary(time<0.0011605000000000001,0.5*(1+cos(4*PI*(time/0.0011605000000000001-0.75))),0.0)))
variable load_fx atom d_area*780.23222477803051*v_amp*v_spatial*d_tx
variable load_fy atom d_area*780.23222477803051*v_amp*v_spatial*d_ty
variable load_fz atom d_area*780.23222477803051*v_amp*v_spatial*d_tz
fix stream surface addforce v_load_fx v_load_fy v_load_fz
fix wallprops all property/atom d_wclear d_wpen d_wtri
fix nativewall clot external pf/callback 1 1
fix flowprops all property/atom d_dragx d_dragy d_dragz d_numx d_numy d_numz
fix earlyflow clot external pf/callback 1 1
fix fixed anchors setforce 0 0 0
fix integrate clot nve
timestep 4.9999999999999998e-07
variable force_mag atom sqrt(v_load_fx^2+v_load_fy^2+v_load_fz^2)
variable local_tau atom v_force_mag/(d_area+1e-100)
compute force_budget surface reduce sum v_force_mag v_load_fx v_load_fy v_load_fz
compute peak_tau surface reduce max v_local_tau
variable actual_budget equal c_force_budget[1]/1.8223166726848543e-06
fix force_history all ave/time 1 1 1 v_actual_budget c_peak_tau c_force_budget[1] c_force_budget[2] c_force_budget[3] c_force_budget[4] file force_history.dat
thermo 100
thermo_style custom step time atoms bonds v_amp v_actual_budget ke
thermo_modify lost error lost/bond error flush yes format float %.17g
timer full
dump trajectory all custom 20 trajectory.lammpstrj id type x y z vx vy vz fx fy fz d_damage v_load_fx v_load_fy v_load_fz d_wclear d_wpen d_wtri f_nativewall[1] f_nativewall[2] f_nativewall[3] d_dragx d_dragy d_dragz d_numx d_numy d_numz
dump_modify trajectory sort id format float %.17g
dump broken all local 20 broken_bonds.local index f_breaks[1] f_breaks[2] f_breaks[3] f_breaks[4] f_breaks[5] f_breaks[6] f_breaks[7] f_breaks[8] f_breaks[9]
dump_modify broken format float %.17g
compute topology all property/local batom1 batom2 btype
dump topology all local 4660 surviving_bonds.local index c_topology[1] c_topology[2] c_topology[3]
run 4660
write_restart final.restart
