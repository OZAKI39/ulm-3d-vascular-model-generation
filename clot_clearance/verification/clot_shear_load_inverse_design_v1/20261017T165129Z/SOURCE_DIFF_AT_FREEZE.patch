+        self.e2=np.array([-np.sin(phi),np.cos(phi),0.])
+        self.center=np.array([self.theta['center_x_m'],self.theta['center_y_m'],surface_z])
+        self.stop=self.theta['drive_duration_s']
+        self.rise=self.stop*5/7; self.hold=self.stop*6/7
