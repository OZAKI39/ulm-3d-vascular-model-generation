+def plateau(r, inner, outer):
+    """C2 plateau taper, exactly zero beyond the fixed laboratory region."""
+    q=np.clip((np.abs(r)-inner)/(outer-inner),0.,1.)
+    return 1.-q*q*q*(10.+q*(-15.+6.*q))
+
+class ShearField:
