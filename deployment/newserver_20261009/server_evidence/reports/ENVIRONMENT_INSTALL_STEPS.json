[
  {
    "name": "create_cfd_venv",
    "command": [
      "uv",
      "venv",
      "--python",
      "/usr/bin/python3",
      "--seed",
      "/workspace/brava_cfd/envs/cfd"
    ],
    "returncode": 0
  },
  {
    "name": "install_cfd_python",
    "command": [
      "uv",
      "pip",
      "install",
      "--python",
      "/workspace/brava_cfd/envs/cfd/bin/python",
      "-r",
      "/workspace/brava_cfd/runtime/requirements.in"
    ],
    "returncode": 0
  },
  {
    "name": "download_isolated_mpi_dependency",
    "command": [
      "apt-get",
      "download",
      "libevent-pthreads-2.1-7t64"
    ],
    "returncode": 0
  },
  {
    "name": "extract_libevent-pthreads-2.1-7t64_2.1.12-stable-9ubuntu2.2_amd64.deb",
    "command": [
      "dpkg-deb",
      "-x",
      "/workspace/brava_cfd/deps/os-packages/libevent-pthreads-2.1-7t64_2.1.12-stable-9ubuntu2.2_amd64.deb",
      "/workspace/brava_cfd/deps/sysroot"
    ],
    "returncode": 0
  }
]
