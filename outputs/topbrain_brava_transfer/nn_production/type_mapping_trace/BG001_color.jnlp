<?xml version="1.0" encoding="utf-8"?>
<jnlp spec="1.0" codebase="http://cng.gmu.edu/brava/cvapp" href="http://cng.gmu.edu/brava/files/file_jnlp_color/BG001_color.jnlp"> 
<information>
<title>Neuron Viewer </title>
<vendor>Krasnow Institute</vendor>
<offline-allowed/>
</information>
<resources>
<jar href="cvapp.jar"
	main="true"/>
<j2se version="1.5+" href="http://java.sun.com/products/autodl/j2se"/>
</resources>
<application-desc main-class="cvapp.main">
<argument>http://cng.gmu.edu/brava/files/file_swc_color/BG001_ColorCoded.CNG.swc</argument>
</application-desc>
<security>
<all-permissions/>
</security>
</jnlp>