# Preserve review evidence bytes, including original line endings.
** -text
# Small geometry evidence is stored as normal Git blobs, without new LFS objects.
*.stl -filter -diff -merge -text
*.vtp -filter -diff -merge -text
*.vti -filter -diff -merge -text
*.npz -filter -diff -merge -text
# Copied historical evidence retains original whitespace; implementation source
# outside this bundle continues to receive normal whitespace checks.
step1/** -whitespace
step2/** -whitespace
step3/** -whitespace
provenance/*.patch -whitespace
