# Preserve archived bytes and keep the two small VTPs as ordinary Git blobs.
* -text
*.vtp -filter -diff -merge -text
# CSV evidence uses CRLF; recognize its CR without suppressing other whitespace checks.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Unified patch context lines and immutable upstream copyright text retain original spaces.
*.diff -whitespace
*.patch -whitespace
provenance/licenses/HEMOCELL_LICENSE -whitespace
# Numerics contract records the generator hash including its historical EOF blank lines.
source/new_medium/scripts/prepare_numerics.py whitespace=-blank-at-eof
