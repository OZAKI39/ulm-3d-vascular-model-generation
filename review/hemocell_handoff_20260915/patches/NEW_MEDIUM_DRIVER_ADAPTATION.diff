+            size_t used=0;T v=std::stod(body.substr(end+1),&used);require(used>0&&std::isfinite(v),"Nonfinite contract value: "+key);return v;
+        }
+        pos+=token.size();
+    }
+    throw std::runtime_error("Missing numerical contract key: "+key);
+}
