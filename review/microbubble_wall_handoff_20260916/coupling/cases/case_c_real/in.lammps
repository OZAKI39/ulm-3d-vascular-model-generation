units si
atom_style sphere
boundary p p p
newton off
processors 1 1 1
read_data particles.data
comm_modify vel yes
pair_style zero 6e-6
pair_coeff * *
neighbor 1e-6 bin
neigh_modify every 1 delay 0 check no
fix integrator all nve/sphere
fix coupling all frozen/flow/drag ../../fields/FROZEN_FLOW_FIELD_V0.h5 0.001 1 trajectory 2.38282920197874e-06 0.00014735638926236119 0.00012876451015280939 0.00012792509833640283 5.9969754243196026e-07
timestep 6.2499999999999991e-11
thermo 1733
thermo_style custom step atoms time ke
thermo_modify lost error norm no format float %.17g
run 0
write_dump all custom initial.dump id diameter mass xu yu zu vx vy vz fx fy fz modify sort id format float %.17g
run 17331
write_dump all custom final.dump id diameter mass xu yu zu vx vy vz fx fy fz modify sort id format float %.17g
print "COUPLING_CASE_COMPLETED"
