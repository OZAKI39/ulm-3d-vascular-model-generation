[unix_http_server]
file=/workspace/brava_flow_roi_18mlmin_20260928/supervisor.sock
chmod=0600
[supervisord]
logfile=/workspace/brava_flow_roi_18mlmin_20260928/logs/supervisord.log
pidfile=/workspace/brava_flow_roi_18mlmin_20260928/supervisord.pid
childlogdir=/workspace/brava_flow_roi_18mlmin_20260928/logs
[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface
[supervisorctl]
serverurl=unix:///workspace/brava_flow_roi_18mlmin_20260928/supervisor.sock
[program:brava_calibration_gpu]
command=/root/particle8_2_runs/env/bin/python -B /workspace/brava_flow_roi_18mlmin_20260928/scripts/solve_remote.py --case /workspace/brava_flow_roi_18mlmin_20260928/cases/calibration_equal_split --reference-root /workspace/brava_flow_roi_18mlmin_20260928
directory=/workspace/brava_flow_roi_18mlmin_20260928
environment=PYTHONDONTWRITEBYTECODE="1",OPENBLAS_NUM_THREADS="1",OMP_NUM_THREADS="1",MKL_NUM_THREADS="1"
autostart=false
autorestart=false
startsecs=1
stopasgroup=true
killasgroup=true
stdout_logfile=/workspace/brava_flow_roi_18mlmin_20260928/logs/calibration_runner.log
redirect_stderr=true
stdout_logfile_maxbytes=0

